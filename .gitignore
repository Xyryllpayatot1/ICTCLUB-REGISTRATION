# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — never commit real secrets
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tests
coverage/
playwright-report/
test-results/
tests/.tmp/

# local database files
*.db
*.db-journal
prisma/dev.db*

# dev email outbox (simulated emails written during development)
.email-outbox/

# NOTE: prisma/postgres/migrations/ IS committed — it is the production
# PostgreSQL DDL deliverable (regenerate with npm run postgres:schema).
