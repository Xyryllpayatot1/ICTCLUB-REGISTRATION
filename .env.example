# ==============================================================================
# MRMNHS ICT Club Teaching Program — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Development: SQLite file (see README). Production: a managed PostgreSQL
# database (e.g. Supabase, Neon, Render). The app refuses to boot in
# production mode with a SQLite file URL.
#
# The Prisma client is generated for the provider found here — `npm run dev`,
# `build` and `start` pick the right one automatically. To switch manually:
#   npm run db:use:sqlite     (local development + tests)
#   npm run db:use:postgres   (apply migrations + PostgreSQL client)
DATABASE_URL="file:./dev.db"
# Production example:
# DATABASE_URL="postgresql://user:password@host:5432/mrmnhs_ict?sslmode=require"
# Supabase example (IPv4 pooler, session mode — the direct db.<ref>.supabase.co
# endpoint is IPv6-only and often unreachable; pooler username is postgres.<ref>):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# Public base URL of the deployment (no trailing slash). Used for links in
# emails, CSRF origin checks and cookie settings.
APP_BASE_URL="http://localhost:3000"
# Secret used for signing/deriving tokens (min 32 chars in production).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------
# Provider: "smtp" (Gmail SMTP — see below), "resend" (Resend HTTP API), or
# "dev-outbox" (development).
# "dev-outbox" does NOT send real email — messages are written to .email-outbox/
# and clearly flagged as simulated in the admin dashboard.
EMAIL_PROVIDER="dev-outbox"
# Required when EMAIL_PROVIDER="resend".
EMAIL_PROVIDER_API_KEY=""
# Verified sender, e.g. "MRMNHS ICT Club <registrations@your-domain.test>"
EMAIL_FROM="MRMNHS ICT Club <onboarding@resend.dev>"
# Optional: address that receives admin notifications about failures.
EMAIL_ADMIN_NOTIFY=""

# Gmail SMTP (EMAIL_PROVIDER="smtp") — smtp.gmail.com:465, implicit TLS.
# Credentials are read server-side ONLY (no NEXT_PUBLIC_ prefix, never logged).
# Create an App Password: Google account → Security → 2-Step Verification →
# App passwords (2-Step Verification must be ON). Spaces in the password are OK.
# Leave EMPTY to disable SMTP sending — the app reports these instructions
# instead of pretending an email was sent.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ------------------------------------------------------------------------------
# Cron / background processing
# ------------------------------------------------------------------------------
# Bearer token protecting /api/cron/email-worker (used by Vercel Cron, cron-job.org,
# GitHub Actions schedule, etc.). Generate like AUTH_SECRET.
CRON_SECRET="change-me-to-a-long-random-cron-secret-at-least-32-chars"
# Interval (ms) for the in-process email worker loop on long-running servers.
# Ignored on serverless platforms — use the cron endpoint there.
EMAIL_WORKER_INTERVAL_MS="15000"

# ------------------------------------------------------------------------------
# Program configuration (adjust with the program organizers)
# ------------------------------------------------------------------------------
ADMIN_EMAILS=""
# Comma-separated list of admin accounts allowed to sign in, e.g.
# "teacher@mrmnhs.edu.ph,club.officer@mrmnhs.edu.ph". Accounts must also exist
# in the database (create them with `npm run admin:create`). Leave empty to
# allow any database-backed admin account (development only).
PROGRAM_TIMEZONE="Asia/Manila"
PROGRAM_START_TIME="19:00"
PROGRAM_END_TIME="20:00"
PROGRAM_SCHEDULE="Sunday-Saturday"
# Initial status applied to new registrations: pending_review | approved | waitlisted
REGISTRATION_STATUS_DEFAULT="pending_review"
# Set to "false" to close the registration form without redeploying.
REGISTRATION_OPEN="true"
# Public contact shown on the site and in emails. Leave empty to hide.
CONTACT_EMAIL=""
# Optional: verified Zoom/meeting link. ONLY set this once confirmed by
# organizers; it is included in approval emails when present.
PROGRAM_MEETING_URL=""
# Optional: a confirmed start date (ISO). Leave empty — nothing is displayed.
PROGRAM_START_DATE=""
